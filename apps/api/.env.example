# Database
#
# How the URL is resolved (in order of precedence):
#   1. If DATABASE_URL is set below, it's used verbatim.
#   2. Else, if POSTGRES_PASSWORD is set, the URL is built as
#      postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
#      (this is what the compose stack uses — only POSTGRES_PASSWORD is required).
#   3. Else, a dev fallback URL is used (postgres on host.docker.internal:5435).
#
# Typical setups:
#   - Local dev with SQLite:           uncomment line below
#   - Local dev with host Postgres:    leave DATABASE_URL unset (tier 3 fallback kicks in)
#   - Docker compose / production:     leave DATABASE_URL unset, set POSTGRES_PASSWORD below

# DATABASE_URL=sqlite:///./storage/app.db

# Postgres container + URL-builder inputs.
# In production (compose), POSTGRES_PASSWORD is the only one that must change.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=app

# Infrastructure
REDIS_URL=redis://localhost:6379/0
CHROMA_PERSIST_DIRECTORY=./storage/chroma

# Langfuse (observability)
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here

# Suppress OpenAI Agents SDK tracing (avoids 401s when not using a real OpenAI key)
OPENAI_AGENTS_DISABLE_TRACING=1

# RAG — Document Insight pipeline (PDF OCR + CSV profiling -> artifacts)
RAG_MISTRAL_API_KEY=your_mistral_api_key_here
RAG_OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
RAG_OPENAI_API_KEY=your_rag_llm_api_key_here
RAG_OPENAI_MODEL=google/gemini-2.5-flash-lite
RAG_MAX_FILE_SIZE_MB=30
RAG_ENABLE_BACKGROUND_PROCESSING=false

# RAG — Embedding model (ChromaDB vectors). Any OpenAI-compatible /embeddings endpoint works.
#   Mistral: base=https://api.mistral.ai/v1, model=mistral-embed (can reuse RAG_MISTRAL_API_KEY)
#   OpenAI:  base=https://api.openai.com/v1, model=text-embedding-3-small
RAG_EMBEDDING_API_BASE_URL=https://api.mistral.ai/v1
RAG_EMBEDDING_API_KEY=your_embedding_api_key_here
RAG_EMBEDDING_MODEL=mistral-embed

# Chat — AI Consultant
CHAT_OPENAI_API_BASE_URL=https://api.openai.com/v1
CHAT_OPENAI_API_KEY=your_chat_llm_api_key_here
CHAT_OPENAI_MODEL=openai/gpt-4o-mini
CHAT_MAX_CONTEXT_TOKENS=12000
CHAT_MAX_OUTPUT_TOKENS=2000

# Optional — web search tool
TAVILY_API_KEY=your_tavily_api_key_here
