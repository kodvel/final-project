# ---- DEV ENV ----
# Copy to apps/api/.env for local development.

# Database
# Pick one:
#   (a) SQLite — simplest, no Postgres needed:
DATABASE_URL=sqlite:///./storage/app.db
#   (b) Postgres on the host (devcontainer / Docker Desktop): leave DATABASE_URL unset.
#       The API falls back to postgresql+psycopg://postgres:postgres@host.docker.internal:5435/app

# Infrastructure
REDIS_URL=redis://localhost:6379/0
CHROMA_PERSIST_DIRECTORY=./storage/chroma

# Background processing OFF in dev (synchronous source processing, no Celery worker required)
RAG_ENABLE_BACKGROUND_PROCESSING=false

# Langfuse (observability) — optional in dev
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here

# Suppress OpenAI Agents SDK tracing
OPENAI_AGENTS_DISABLE_TRACING=1

# RAG — Document Insight pipeline
RAG_MISTRAL_API_KEY=
RAG_OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
RAG_OPENAI_API_KEY=your_rag_llm_api_key_here
RAG_OPENAI_MODEL=google/gemini-2.5-flash-lite
RAG_MAX_FILE_SIZE_MB=30

# RAG — Embedding model
RAG_EMBEDDING_API_BASE_URL=https://api.mistral.ai/v1
RAG_EMBEDDING_API_KEY=your_embedding_api_key_here
RAG_EMBEDDING_MODEL=mistral-embed

# Chat — AI Consultant
CHAT_OPENAI_API_BASE_URL=https://api.openai.com/v1
CHAT_OPENAI_API_KEY=your_chat_llm_api_key_here
CHAT_OPENAI_MODEL=openai/gpt-4o-mini
CHAT_MAX_CONTEXT_TOKENS=12000
CHAT_MAX_OUTPUT_TOKENS=2000

# Optional — web search tool
TAVILY_API_KEY=your_tavily_api_key_here
