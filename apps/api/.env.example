DATABASE_URL=sqlite:///./storage/app.db
OPENAI_API_KEY=your_openai_api_key_here
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com
REDIS_URL=redis://localhost:6379/0
CHROMA_PERSIST_DIRECTORY=./storage/chroma

# RAG / Document Insight pipeline
RAG_MISTRAL_API_KEY=your_mistral_api_key_here
RAG_OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
RAG_OPENAI_API_KEY=your_rag_llm_api_key_here
RAG_OPENAI_MODEL=google/gemini-2.5-flash-lite
RAG_MAX_FILE_SIZE_MB=30
RAG_ENABLE_BACKGROUND_PROCESSING=false

# RAG / Embedding model
RAG_EMBEDDING_API_BASE_URL=https://api.openai.com/v1
RAG_EMBEDDING_API_KEY=your_embedding_api_key_here
RAG_EMBEDDING_MODEL=text-embedding-3-small

# Chat / AI Consultant
CHAT_OPENAI_API_BASE_URL=https://api.openai.com/v1
CHAT_OPENAI_API_KEY=your_chat_llm_api_key_here
CHAT_OPENAI_MODEL=openai/gpt-4o-mini
CHAT_MAX_CONTEXT_TOKENS=12000
CHAT_MAX_OUTPUT_TOKENS=2000
TAVILY_API_KEY=your_tavily_api_key_here
