# ---- PROD ENV ----
# Copy to apps/api/.env on the VPS.
# REDIS_URL, CHROMA_PERSIST_DIRECTORY, CORS_ALLOWED_ORIGINS, and RAG_ENABLE_BACKGROUND_PROCESSING
# are set in docker-compose.yml — do not duplicate them here.

# Database (auto-builds DATABASE_URL as postgresql+psycopg://USER:PASS@postgres:5432/DB)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=app

# Observability
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OPENAI_AGENTS_DISABLE_TRACING=1

# LLM — shared API (OpenRouter)
RAG_OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
RAG_OPENAI_API_KEY=
RAG_EXTRACTION_MODEL=google/gemini-2.5-flash-lite
RAG_GENERATION_MODEL=google/gemini-2.5-flash-lite
RAG_CLASSIFICATION_MODEL=google/gemini-2.5-flash-lite
RAG_CHAT_MODEL=openai/gpt-4o-mini
RAG_MAX_FILE_SIZE_MB=30

# LLM — Embeddings (Mistral)
RAG_MISTRAL_API_KEY=
RAG_EMBEDDING_API_BASE_URL=https://api.mistral.ai/v1
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=mistral-embed

# Chat limits
CHAT_MAX_CONTEXT_TOKENS=12000
CHAT_MAX_OUTPUT_TOKENS=2000

# Web search (optional)
TAVILY_API_KEY=
