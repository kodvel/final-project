# ---- PROD ENV (docker compose / VPS) ----
# Copy to apps/api/.env on the VPS.
# REDIS_URL, CHROMA_PERSIST_DIRECTORY, CORS_ALLOWED_ORIGINS, and RAG_ENABLE_BACKGROUND_PROCESSING
# are set inline in docker-compose.yml — do NOT duplicate them here.

# Database
# DATABASE_URL is auto-built from POSTGRES_* below (postgresql+psycopg://USER:PASS@postgres:5432/DB).
# All three must be set so the postgres container initdb matches the URL the API expects.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=app

# Langfuse (observability)
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Suppress OpenAI Agents SDK tracing
OPENAI_AGENTS_DISABLE_TRACING=1

# RAG — Document Insight pipeline
RAG_MISTRAL_API_KEY=
RAG_OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
RAG_OPENAI_API_KEY=
RAG_OPENAI_MODEL=google/gemini-2.5-flash-lite
RAG_MAX_FILE_SIZE_MB=30

# RAG — Embedding model
RAG_EMBEDDING_API_BASE_URL=https://api.mistral.ai/v1
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=mistral-embed

# Chat — AI Consultant
CHAT_OPENAI_API_BASE_URL=https://api.openai.com/v1
CHAT_OPENAI_API_KEY=
CHAT_OPENAI_MODEL=openai/gpt-4o-mini
CHAT_MAX_CONTEXT_TOKENS=12000
CHAT_MAX_OUTPUT_TOKENS=2000

# Optional — web search tool
TAVILY_API_KEY=
